# cd
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# dangling symlinks in the current directory, no recursion
# find -xtype is GNU-only, so use the POSIX form
alias find-dangling-links='find . -maxdepth 1 -type l ! -exec test -e {} \; -print'

# [ development ]
alias gitrepos="cd $GIT_REPOS"
alias devbin="cd $DEVELOPMENT_BIN"
alias devsh="cd $DEVELOPMENT_SH"
alias mybin="cd $LOCAL_BIN"
alias dl="cd ~/Downloads"
