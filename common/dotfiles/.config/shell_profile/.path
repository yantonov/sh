# common
export DEVELOPMENT_HOME=$HOME/Development
export DEVELOPMENT_BIN=$DEVELOPMENT_HOME/bin
export DEVELOPMENT_SH=$DEVELOPMENT_HOME/sh
export GIT_REPOS=$DEVELOPMENT_HOME/git

add_to_path() {
    local_tmp_path="$1"
    export PATH="${local_tmp_path}:${PATH}"
    unset local_tmp_path
}

add_home_bin_items_to_path() {
    local_home_bin="${HOME}/.local/bin"
    mkdir -p "${local_home_bin}"

    local_old_ifs=$IFS
    IFS='
'
    set -- $(find "${local_home_bin}" -maxdepth 1 | sort)
    IFS=$local_old_ifs

    for local_entry do
        if [ -L "$local_entry" ]; then
            local_real_path=$(readlink "$local_entry")
            if [ -d "$local_real_path" ]; then
                add_to_path "$local_real_path"
            fi
        elif [ -d "$local_entry" ]; then
            add_to_path "$local_entry"
        fi
    done

    unset local_home_bin local_old_ifs local_entry local_real_path
}

# keep only first occurence
# why first, because first will be used actually based on the order
dedup_path() {
    local_old_ifs=$IFS
    IFS=:
    set -- $PATH
    IFS=$local_old_ifs

    local_new=

    for local_dir do
        case ":$local_new:" in
            *":$local_dir:"*)
                # already seen
                ;;
            *)
                if [ -n "$local_new" ]; then
                    local_new=$local_new:$local_dir
                else
                    local_new=$local_dir
                fi
                ;;
        esac
    done

    PATH=$local_new
    export PATH

    unset local_old_ifs local_new local_dir
}


# show current PATHs
paths() {
  echo "$PATH" | tr ':' '\n' | nl
}

# show list of PATH items without line enumeration
rawpaths() {
  echo "$PATH" | tr ':' '\n'
}
